---
// Small ornament divider: line · cross+circle · line
---

<div class="flex items-center justify-center gap-3 py-1 ornament-divider" aria-hidden="true">
  <span class="line"></span>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
    <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.2" opacity="0.6"/>
    <circle cx="12" cy="12" r="2" fill="currentColor"/>
    <line x1="12" y1="3" x2="12" y2="7" stroke="currentColor" stroke-width="1.5"/>
    <line x1="12" y1="17" x2="12" y2="21" stroke="currentColor" stroke-width="1.5"/>
    <line x1="3" y1="12" x2="7" y2="12" stroke="currentColor" stroke-width="1.5"/>
    <line x1="17" y1="12" x2="21" y2="12" stroke="currentColor" stroke-width="1.5"/>
  </svg>
  <span class="line"></span>
</div>

<style>
  .ornament-divider { color: var(--color-bronze); opacity: 0.5; }
  :global(.dark) .ornament-divider { color: var(--color-foreground); opacity: 0.3; }
  .ornament-divider .line {
    width: 52px;
    height: 1px;
    background: currentColor;
  }
</style>
