---
// Slowly rotating compass ornament (Professional mode only)
---

<div class="compass-wrap" data-mode="professional" style="display: none;" aria-hidden="true">
  <svg width="80" height="80" viewBox="0 0 100 100" class="animate-compass">
    <g fill="none" stroke="currentColor" stroke-width="1">
      <circle cx="50" cy="50" r="40"/>
      <circle cx="50" cy="50" r="30"/>
      <circle cx="50" cy="50" r="20"/>
      <circle cx="50" cy="50" r="10"/>
      <line x1="60" y1="50" x2="90" y2="50"/>
      <line x1="57.07" y1="57.07" x2="78.28" y2="78.28"/>
      <line x1="50" y1="60" x2="50" y2="90"/>
      <line x1="42.93" y1="57.07" x2="21.72" y2="78.28"/>
      <line x1="40" y1="50" x2="10" y2="50"/>
      <line x1="42.93" y1="42.93" x2="21.72" y2="21.72"/>
      <line x1="50" y1="40" x2="50" y2="10"/>
      <line x1="57.07" y1="42.93" x2="78.28" y2="21.72"/>
    </g>
    <circle cx="50" cy="50" r="3" fill="currentColor"/>
  </svg>
</div>

<style>
  /* Inline style="display:none" hides it initially; the toggle JS clears that
     inline style, falling back to this flex layout for centering. */
  .compass-wrap {
    display: flex;
    justify-content: center;
    margin: 0.5rem 0;
    color: rgba(202, 157, 43, 0.42);
  }
</style>
