---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import SocialLinks from './SocialLinks.astro';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="flex scroll-mt-8 flex-col gap-y-4">
  <h2 class="font-cormorant text-2xl font-semibold text-foreground">{t('sayHiTitle')}</h2>

  <p class="max-w-2xl text-[0.95rem] leading-relaxed text-muted-foreground">
    {t('sayHiIntro')}
  </p>

  <SocialLinks lang={lang} variant="list" />
</section>
