---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { currently } from '../data/currently';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const items = currently[lang];
---

<section class="flex flex-col gap-y-4">
  <h2 class="font-cormorant text-2xl font-semibold text-foreground">{t('currentlyTitle')}</h2>

  <ul class="currently-list flex flex-col gap-y-2.5">
    {items.map((item) => (
      <li class="flex gap-x-3 text-[1.25rem] leading-relaxed text-muted-foreground">
        <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-gold/70" aria-hidden="true"></span>
        <span set:html={item} />
      </li>
    ))}
  </ul>
</section>

<style>
  .currently-list :global(strong) {
    color: var(--color-foreground);
    font-weight: 600;
  }

  .currently-list :global(a) {
    color: var(--color-gold);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }

  .currently-list :global(a:hover) {
    color: var(--color-bronze);
  }
</style>
