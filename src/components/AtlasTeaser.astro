---
import type { Locale } from '../i18n/utils';
import { getLocalePath } from '../i18n/utils';
import { atlas } from '../data/atlas';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const c = atlas[lang];
const atlasPath = getLocalePath(lang, '/atlas/');
---

<section class="flex flex-col gap-y-4">
  <h2 class="font-cormorant text-2xl font-semibold text-foreground">{c.teaserKicker}</h2>

  <a
    href={atlasPath}
    class="atlas-teaser group flex flex-col gap-y-3 rounded-xl border border-border bg-card p-5 transition-colors hover:border-gold/40 sm:p-6"
  >
    <p class="text-[1.25rem] leading-relaxed text-muted-foreground">
      {c.teaserBody}
    </p>
    <span class="text-sm font-medium text-gold transition-colors group-hover:text-bronze">
      {c.teaserCta}
    </span>
  </a>
</section>
