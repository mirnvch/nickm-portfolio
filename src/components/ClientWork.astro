---
import type { Locale } from '../i18n/utils';
import { useTranslations, getLocalePath } from '../i18n/utils';
import type { Project } from '../data/projects';

interface Props {
  projects: Project[];
  lang?: Locale;
}

const { projects, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section class="flex flex-col gap-y-5">
  <h2 class="font-cormorant text-2xl font-semibold text-foreground">{t('clientWorkTitle')}</h2>

  <div class="flex flex-col gap-y-4">
    {projects.map((project) => (
      <article class="flex flex-col gap-y-4 rounded-xl border border-border bg-card p-5 sm:flex-row sm:gap-x-5 sm:p-6">
        <!-- Logo -->
        <a
          href={getLocalePath(lang, `/projects/${project.slug}/`)}
          class="flex h-20 w-20 shrink-0 items-center justify-center self-start rounded-lg bg-background p-3"
          aria-label={project.title}
        >
          {project.image ? (
            <img src={project.image} alt={project.title} class="max-h-full max-w-full object-contain" loading="lazy" />
          ) : (
            <span class="font-cormorant text-2xl font-semibold text-gold">{project.title.charAt(0).toUpperCase()}</span>
          )}
        </a>

        <!-- Content -->
        <div class="flex flex-1 flex-col gap-y-2">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <h3 class="font-cormorant text-xl font-semibold text-foreground">{project.title}</h3>
            {project.status && (
              <span class="rounded-full bg-background px-2 py-0.5 text-xxs font-medium text-muted-foreground">
                {project.status}
              </span>
            )}
          </div>

          <p class="text-[0.95rem] leading-relaxed text-muted-foreground">
            {project.summary ?? project.description}
          </p>

          {project.result && (
            <p class="flex items-baseline gap-2 text-sm text-foreground">
              <span class="text-gold" aria-hidden="true">→</span>
              <span>{project.result}</span>
            </p>
          )}

          <div class="mt-1 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
            <a
              href={getLocalePath(lang, `/projects/${project.slug}/`)}
              class="text-gold transition-colors hover:text-bronze"
            >
              {t('viewProject')}
            </a>
            {project.link && (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted-foreground transition-colors hover:text-foreground"
              >
                {t('visitSite')}
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
