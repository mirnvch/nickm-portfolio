---
import type { Locale } from '../i18n/utils';
import { socials, type SocialIcon } from '../data/socials';

interface Props {
  lang?: Locale;
  variant?: 'list' | 'icons';
}

const { lang = 'en', variant = 'list' } = Astro.props;

// 24×24 viewBox, currentColor fill.
const iconPaths: Record<SocialIcon, string> = {
  linkedin:
