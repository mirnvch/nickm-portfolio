---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<div class="toggle-wrapper">
  <!-- Left compass ornament -->
  <span class="compass-orn" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1" opacity="0.4"/>
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1" opacity="0.6"/>
      <circle cx="12" cy="12" r="2" fill="currentColor" opacity="0.8"/>
      <line x1="12" y1="4" x2="12" y2="7" stroke="currentColor" stroke-width="1.5"/>
      <line x1="12" y1="17" x2="12" y2="20" stroke="currentColor" stroke-width="1.5"/>
      <line x1="4" y1="12" x2="7" y2="12" stroke="currentColor" stroke-width="1.5"/>
      <line x1="17" y1="12" x2="20" y2="12" stroke="currentColor" stroke-width="1.5"/>
    </svg>
  </span>

  <!-- Toggle track -->
  <div class="toggle-track" id="toggle-track">
    <!-- Diamond pattern background -->
    <svg class="diamond-bg" aria-hidden="true" preserveAspectRatio="none">
      <defs>
        <pattern id="dp" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M10 0 L20 10 L10 20 L0 10 Z" fill="none" stroke="rgb(180,160,120)" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#dp)"/>
    </svg>

    <!-- Sliding indicator -->
    <div class="toggle-indicator" id="toggle-indicator"></div>

    <button id="mode-professional" class="toggle-btn" data-mode-btn="professional" aria-label={`${t('professional')} mode`}>
      <span class="icon" aria-hidden="true">⚙</span>
      <span>{t('professional')}</span>
    </button>
    <button id="mode-personal" class="toggle-btn" data-mode-btn="personal" aria-label={`${t('personal')} mode`}>
      <span class="icon" aria-hidden="true">✦</span>
      <span>{t('personal')}</span>
    </button>
  </div>

  <!-- Right compass ornament -->
  <span class="compass-orn" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1" opacity="0.4"/>
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1" opacity="0.6"/>
      <circle cx="12" cy="12" r="2" fill="currentColor" opacity="0.8"/>
      <line x1="12" y1="4" x2="12" y2="7" stroke="currentColor" stroke-width="1.5"/>
      <line x1="12" y1="17" x2="12" y2="20" stroke="currentColor" stroke-width="1.5"/>
      <line x1="4" y1="12" x2="7" y2="12" stroke="currentColor" stroke-width="1.5"/>
      <line x1="17" y1="12" x2="20" y2="12" stroke="currentColor" stroke-width="1.5"/>
    </svg>
  </span>
</div>

<style>
  .toggle-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .compass-orn {
    width: 22px;
    height: 22px;
    opacity: 0.35;
    color: var(--color-foreground);
    flex-shrink: 0;
  }
  .compass-orn svg { width: 100%; height: 100%; display: block; }

  .toggle-track {
    position: relative;
    width: 280px;
    height: 48px;
    border-radius: 32px;
    overflow: hidden;
    display: flex;
    background: var(--color-card);
  }

  /* Professional (dark) */
  :global(.dark) .toggle-track {
    border: 1px solid rgba(202, 157, 43, 0.2);
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.1), 0 2px 12px rgba(202, 157, 43, 0.1);
  }
  /* Personal (light) */
  :global(html:not(.dark)) .toggle-track {
    border: 1px solid rgba(166, 115, 63, 0.3);
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.04), 0 2px 8px rgba(166, 115, 63, 0.08);
  }

  .diamond-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.07;
    z-index: 0;
    pointer-events: none;
  }

  .toggle-indicator {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 132px;
    height: 40px;
    border-radius: 32px;
    z-index: 0;
    backdrop-filter: blur(12px);
    transition: left 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55),
                background 0.4s ease, box-shadow 0.4s ease;
  }

  :global(.dark) .toggle-indicator {
    left: 4px;
    background: linear-gradient(135deg, rgba(202, 157, 43, 0.5), rgba(202, 157, 43, 0.3));
    box-shadow: 0 4px 16px rgba(202, 157, 43, 0.25), 0 2px 8px rgba(202, 157, 43, 0.15), inset 0 1px 2px rgba(255, 255, 255, 0.2);
  }
  :global(html:not(.dark)) .toggle-indicator {
    left: 144px;
    background: linear-gradient(135deg, rgba(184, 80, 46, 0.5), rgba(184, 80, 46, 0.3));
    box-shadow: 0 4px 16px rgba(184, 80, 46, 0.2), 0 2px 8px rgba(184, 80, 46, 0.12), inset 0 1px 2px rgba(255, 255, 255, 0.3);
  }

  .toggle-btn {
    position: relative;
    z-index: 1;
    flex: 1;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-garamond);
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(128, 128, 128, 0.55);
    transition: color 0.3s ease;
  }
  .toggle-btn .icon { font-size: 0.75rem; }

  .toggle-btn:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
    border-radius: 32px;
  }

  :global(.dark) #mode-professional,
  :global(html:not(.dark)) #mode-personal {
    color: var(--color-foreground);
    font-weight: 600;
  }
</style>

<script>
  declare global {
    interface Window {
      setMode?: (mode: 'professional' | 'personal') => void;
    }
  }

  function applyVisibility() {
    const isDark = document.documentElement.classList.contains('dark');
    document.querySelectorAll('[data-mode]').forEach((el) => {
      if (el.hasAttribute('data-mode-btn')) return;
      const elMode = el.getAttribute('data-mode');
      const htmlEl = el as HTMLElement;
      if ((elMode === 'professional' && isDark) || (elMode === 'personal' && !isDark)) {
        htmlEl.style.display = '';
        htmlEl.classList.remove('animate-out');
        void htmlEl.offsetWidth;
        htmlEl.classList.add('animate-in');
      } else {
        htmlEl.style.display = 'none';
        htmlEl.classList.remove('animate-in', 'animate-out');
      }
    });
  }

  function initModeToggle() {
    const professionalBtn = document.getElementById('mode-professional');
    const personalBtn = document.getElementById('mode-personal');

    function setMode(mode: 'professional' | 'personal') {
      const html = document.documentElement;
      const flipContainer = document.querySelector('.flip-container');

      if (mode === 'professional') {
        html.classList.add('dark');
        flipContainer?.classList.remove('flipped');
      } else {
        html.classList.remove('dark');
        flipContainer?.classList.add('flipped');
      }

      applyVisibility();

      const url = new URL(window.location.href);
      url.searchParams.set('mode', mode);
      window.history.replaceState({}, '', url);
    }

    window.setMode = setMode;

    professionalBtn?.addEventListener('click', () => setMode('professional'));
    personalBtn?.addEventListener('click', () => setMode('personal'));

    // Set theme from URL (homepage defaults to professional), then sync content
    const initialMode = new URLSearchParams(window.location.search).get('mode') === 'personal'
      ? 'personal' : 'professional';
    const html = document.documentElement;
    const flip = document.querySelector('.flip-container');
    if (initialMode === 'personal') {
      html.classList.remove('dark');
      flip?.classList.add('flipped');
    } else {
      html.classList.add('dark');
      flip?.classList.remove('flipped');
    }
    applyVisibility();
  }

  document.addEventListener('DOMContentLoaded', initModeToggle);
  document.addEventListener('astro:after-swap', initModeToggle);
</script>
