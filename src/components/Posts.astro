---
import type { Locale } from '../i18n/utils';
import { useTranslations, formatDate, getLocalePath } from '../i18n/utils';

interface Post {
  title: string;
  slug: string;
  date: Date;
  readTime: number;
  pinned?: boolean;
}

interface Props {
  posts: Post[];
  mode: 'professional' | 'personal';
  lang?: Locale;
}

const { posts, mode, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const basePath = getLocalePath(lang, mode === 'professional' ? '/blog' : '/notes');
const viewAllText = mode === 'professional' ? t('viewAllPosts') : t('viewAllNotes');
---

<div class="flex flex-col gap-y-4">
  <ul class="flex flex-col gap-y-3">
    {posts.map((post) => (
      <li class="flex items-baseline justify-between gap-4">
        <div class="flex min-w-0 items-baseline gap-2">
          {mode === 'personal' && post.pinned && <span class="shrink-0 text-[11px] text-gold" aria-hidden="true">✦</span>}
          <a
            href={`${basePath}/${post.slug}/`}
            class="post-underline font-cormorant text-lg font-semibold text-foreground"
          >
            {post.title}
          </a>
          <span class="shrink-0 text-[12px] text-muted-foreground">· {post.readTime} {t('minRead')}</span>
        </div>
        <time
          datetime={post.date.toISOString()}
          class="hidden shrink-0 text-[13px] text-muted-foreground sm:block"
        >
          {formatDate(post.date, lang)}
        </time>
      </li>
    ))}
  </ul>

  <a
    href={basePath}
    class="self-start text-sm text-muted-foreground transition-colors hover:text-foreground"
  >
    {viewAllText}
  </a>
</div>
