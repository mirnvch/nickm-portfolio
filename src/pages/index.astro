---
import Layout from '../layouts/Layout.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import ModeToggle from '../components/ModeToggle.astro';
import Section from '../components/Section.astro';
import OrnamentDivider from '../components/OrnamentDivider.astro';
import Compass from '../components/Compass.astro';
import Posts from '../components/Posts.astro';
import StuffGrid from '../components/StuffGrid.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { useTranslations } from '../i18n/utils';
import { getAllPosts } from '../data/posts';
import type { Locale } from '../i18n/utils';

const lang: Locale = 'en';
const t = useTranslations(lang);

const allPosts = getAllPosts(lang);
const professionalPosts = allPosts
  .filter(p => p.type === 'professional')
  .map(p => ({ title: p.title, slug: p.slug, date: p.date, readTime: p.readTime, pinned: p.pinned }))
  .slice(0, 2);
const personalPosts = allPosts
  .filter(p => p.type === 'personal')
  .map(p => ({ title: p.title, slug: p.slug, date: p.date, readTime: p.readTime, pinned: p.pinned }));
---

<Layout title={t('siteTitle')} description={t('siteDescription')} lang={lang} jsonLd={{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Nick Miranovich",
  "url": "https://nickm-portfolio.vercel.app",
  "jobTitle": "QA Engineer",
  "knowsAbout": ["QA Testing", "Test Automation", "Test Coverage", "AI", "Playwright", "n8n"],
  "sameAs": [
    "https://www.linkedin.com/in/mirnvch/",
    "https://github.com/mirnvch",
    "https://t.me/qa_mirnvch"
  ]
}}>
  <!-- Header Navigation -->
  <header class="relative mb-6 flex w-full flex-col items-center gap-4 sm:flex-row sm:justify-between">
    <a href="/" class="font-cormorant text-[18px] font-semibold text-foreground opacity-85 transition-opacity hover:opacity-100">
      {t('home')}
    </a>
    <div class="order-last sm:order-none sm:absolute sm:left-1/2 sm:-translate-x-1/2">
      <ModeToggle lang={lang} />
    </div>
    <LanguageSwitcher lang={lang} />
  </header>

  <!-- Profile -->
  <section class="flex flex-col items-center gap-y-4">
    <ProfilePhoto
      professionalImage="/images/profile-professional.jpg"
      personalImage="/images/profile-personal.jpg"
    />
    <h1 class="font-cormorant text-[48px] font-semibold leading-tight text-foreground" style="letter-spacing: 0.075em;" data-mode="professional">
      {t('nameProfessional')}
    </h1>
    <h1 class="font-cormorant text-[48px] font-semibold leading-tight text-foreground" style="letter-spacing: 0.075em; display: none;" data-mode="personal">
      {t('namePersonal')}
    </h1>
  </section>

  <!-- About (label + content; text swaps by mode) -->
  <Section label={t('aboutLabel')}>
    <div class="about-text" data-mode="professional" set:html={t('aboutProfessional')} />
    <div class="about-text about-lg" data-mode="personal" style="display: none;" set:html={t('aboutPersonal')} />
  </Section>

  <OrnamentDivider />

  <!-- Posts (Professional) -->
  <Section label={t('postsLabel')} mode="professional">
    <Posts posts={professionalPosts} mode="professional" lang={lang} />
  </Section>

  <!-- Posts (Personal) -->
  <Section label={t('postsLabel')} mode="personal">
    <Posts posts={personalPosts} mode="personal" lang={lang} />
  </Section>

  <!-- Compass ornament (Professional) -->
  <Compass />

  <!-- Stuff I've Made (Professional) -->
  <Section label={t('stuffTitle')} mode="professional">
    <StuffGrid lang={lang} />
  </Section>
</Layout>
